# ─────────────────────────────────────────────
# ExpiryTracker — environment variable reference
# ─────────────────────────────────────────────
# Copy this file to .env (never commit .env).
# All variables are optional unless marked REQUIRED.

# ── Database ──────────────────────────────────
# REQUIRED. PostgreSQL connection string.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/expirytracker

# TLS certificate verification for the database connection. Verification is ON
# by default. Set to exactly "false" ONLY if your provider presents a
# certificate chain Node cannot verify — it disables MITM protection on the
# API→database hop. Localhost connections never use TLS.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── API Server ────────────────────────────────
# REQUIRED. Port the Express API server listens on.
PORT=3001

# Node environment. Use "production" in deployed environments.
# Affects log formatting (pretty-print vs. JSON) and certain security defaults.
NODE_ENV=development

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Business Logic ────────────────────────────
# Days within which an item is classified as "expiring soon".
# Default: 30
EXPIRING_SOON_DAYS=30

# Days within which an item counts toward the "expiring this week" dashboard bucket.
# Default: 7
EXPIRING_THIS_WEEK_DAYS=7

# Human-readable application name used in logs.
# Default: ExpiryOS
APP_NAME=ExpiryOS

# ── Security ──────────────────────────────────
# REQUIRED when NODE_ENV=production. HMAC key used to sign the anonymous
# session cookie. The cookie identifies the visitor's private "room" and is the
# tenancy key for every item query, so without a signature the rooms would be
# forgeable. The API refuses to start in production if this is unset.
# Generate with: openssl rand -base64 32
# SESSION_SECRET=

# ── Abuse limits ──────────────────────────────
# The API is an anonymous demo: every fresh room is seeded with sample data and
# every visitor may create rows. These bounds keep that from being abused.
# All are optional; defaults shown.

# Max items in a single anonymous demo room. Default: 100
MAX_ITEMS_PER_OWNER=100

# Rate-limit window, in milliseconds. Default: 60000
RATE_LIMIT_WINDOW_MS=60000

# Requests per IP per window across the whole API. Default: 300
RATE_LIMIT_MAX_GLOBAL=300

# Waitlist signups per IP per window. Default: 5
RATE_LIMIT_MAX_LEADS=5

# Demo-session resets per IP per window. Default: 10
RATE_LIMIT_MAX_RESET=10

# Item-creation requests per IP per window. Default: 60
RATE_LIMIT_MAX_ITEM_WRITES=60

# ── CORS (API server) ─────────────────────────
# REQUIRED when NODE_ENV=production. The exact frontend origin that may call
# the API cross-origin (e.g. https://expiryos.netlify.app). If unset in
# production the API refuses to start (see app.ts).
FRONTEND_URL=https://expiryos.netlify.app

# ── Frontend (Vite) ───────────────────────────
# These are injected by the Replit/Vite build system and do not need
# to be set manually in most development environments.
# VITE_API_BASE_URL=http://localhost:3001
