{
  "name": "expiry-os",
  "private": true,
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @workspace/db run push && pnpm --filter @workspace/api-server run build",
    "build:web": "pnpm --filter @workspace/expiry-tracker run build",
    "start:api": "pnpm --filter @workspace/api-server run start",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
